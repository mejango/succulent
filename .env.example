# Public site origin, used for canonical + social URLs.
NEXT_PUBLIC_SITE_URL=https://succulent.money
# Indexer. Defaults to the production bendystraw when unset.
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
# Optional RPC overrides for wallet reads (creation fee, terminal lookup). Unset = the chain's public RPC.
NEXT_PUBLIC_RPC_1=
NEXT_PUBLIC_RPC_10=
NEXT_PUBLIC_RPC_8453=
NEXT_PUBLIC_RPC_42161=
# Para embedded wallet (email / phone / social sign-in). Both required to enable it; without
# them the app falls back to the browser's injected wallet. Same values as juicebox.money.
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENV=BETA
# WalletConnect project id; absent = no WalletConnect option.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
